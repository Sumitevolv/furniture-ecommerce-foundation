{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "_comment": "Overridden in production by the DB_CONNECTION_STRING env var (ASP.NET Core maps ConnectionStrings__DefaultConnection).",
    "DefaultConnection": ""
  },

  "Jwt": {
    "_comment": "Secret is REQUIRED and must come from the JWT_SECRET env var (Jwt__Secret). Never commit a real value here.",
    "Secret": "",
    "Issuer": "FurnitureShopApi",
    "Audience": "FurnitureShopClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },

  "Storage": {
    "_comment": "Provider is either 'Cloudinary' or 'S3'.",
    "Provider": "Cloudinary"
  },

  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },

  "AwsS3": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "ap-south-1",
    "BucketName": "",
    "CdnBaseUrl": ""
  },

  "Razorpay": {
    "KeyId": "",
    "KeySecret": "",
    "WebhookSecret": ""
  },

  "OpenAi": {
    "ApiKey": "",
    "ChatModel": "gpt-4o-mini",
    "MaxTokens": 500,
    "Enabled": true
  }
}
